---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="10 mind-bending algorithms that will blow your mind. Interactive visualizations and explanations." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --white: #ffffff;
    --ice: #f0f9ff;
    --light-blue-50: #e0f2fe;
    --light-blue-100: #bae6fd;
    --light-blue-200: #7dd3fc;
    --light-blue-300: #38bdf8;
    --light-blue-400: #0ea5e9;
    --light-blue-500: #0284c7;
    --light-blue-600: #0369a1;
    --dark: #0c4a6e;
    --darker: #082f49;
    --text: #1e293b;
    --text-light: #64748b;
    --card-shadow: 0 4px 24px rgba(14, 165, 233, 0.08);
    --card-shadow-hover: 0 8px 40px rgba(14, 165, 233, 0.18);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--white);
    color: var(--text);
    line-height: 1.6;
    overflow-x: hidden;
  }

  code, pre {
    font-family: 'JetBrains Mono', monospace;
  }

  ::selection {
    background: var(--light-blue-200);
    color: var(--darker);
  }
</style>
